{
  "name": "dsh-nascence-pet",
  "version": "3.2.0",
  "description": "Timeless Nascence 桌宠：透明动画、星尘余额与花费提示",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./icon": "./icon.png",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "icon": "./icon.png",
  "files": [
    "locale",
    "lib",
    "assets",
    "docs",
    "tests",
    "icon.png",
    "cordis.patch.yml",
    "README.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "scripts": {
    "build:client": "node tools/build-client.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "check": "node --check lib/index.js && node --check assets/src/main.js && node --check assets/src/client-entry.js"
  },
  "keywords": [
    "dsh-plugin",
    "desktop-pet",
    "video",
    "nascence",
    "timeless-nascence",
    "pixel-art"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.2.0"
  },
  "license": "MIT",
  "author": "dsh-nascence contributors",
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
