[
 {
  "i": 0,
  "text": "管理员，今天也一起看看这片宇宙吧。",
  "file": "vo_00.mp3",
  "sec": 3.396
 },
 {
  "i": 1,
  "text": "开心、发呆、难过——我都演给你看。",
  "file": "vo_01.mp3",
  "sec": 4.362
 },
 {
  "i": 2,
  "text": "把界面换成深空的颜色，就只剩下一道光。",
  "file": "vo_02.mp3",
  "sec": 4.049
 },
 {
  "i": 3,
  "text": "暗一点的宇宙，好像更适合待久一点。",
  "file": "vo_03.mp3",
  "sec": 3.474
 },
 {
  "i": 4,
  "text": "星尘花去了哪里，我都替你记着。",
  "file": "vo_04.mp3",
  "sec": 3.161
 },
 {
  "i": 5,
  "text": "两个仓库，各自独立，挑你喜欢的装就好。",
  "file": "vo_05.mp3",
  "sec": 4.049
 },
 {
  "i": 6,
  "text": "来探索新的宇宙吧，管理员。",
  "file": "vo_06.mp3",
  "sec": 2.508
 }
]